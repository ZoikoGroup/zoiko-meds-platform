# ZoikoMeds — Android app (Capacitor) build.
# Loaded by `vite build --mode mobile`, which ../zoiko-meds-app/scripts/build-web.mjs runs.
#
# Committed on purpose: nothing here is secret. Every value is compiled into the
# JavaScript bundle and is readable by anyone who unzips the APK.

VITE_PLATFORM=mobile

# Inside the app the page is served from https://localhost (the phone), so a
# relative base like /internal would point at the device. Pin the real API.
VITE_API_BASE_URL=https://get.zoikomeds.com/api

# The public web app. Deep links (App Links) are accepted only from this origin,
# and it is the domain that must publish /.well-known/assetlinks.json.
VITE_WEB_ORIGIN=https://app.zoikomeds.com

# The Super Admin console stays on the web. Set to true to ship it in the app.
VITE_ADMIN_CONSOLE=false
