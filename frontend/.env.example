# ZoikoMeds Frontend — Environment template
# Vite only exposes variables prefixed with VITE_ to client code.
# Copy this file to .env and fill in values for your environment.

# Base URL of the ZoikoMeds internal API gateway proxy
VITE_API_BASE_URL=/internal

# API version prefix
VITE_API_VERSION=v2

# App metadata
VITE_APP_NAME=ZoikoMeds
VITE_APP_ENV=development

# Feature flags
VITE_ENABLE_MOCK_DATA=true

# Published Trust Center (security, privacy and governance posture).
# Unset until the /trust site ships: while it is empty, the Trust Center links
# on Leadership & Oversight point at the standards published on that page
# instead of at nothing. Set this and they become external links to the real
# site — no code change needed.
VITE_TRUST_CENTER_URL=
