# ZoikoMeds Backend — environment template. Copy to .env and fill in.

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Comma-separated list of allowed browser origins (Vite dev server is :5173).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zoikomeds?schema=public"

# Auth — JWT signing. Use a long, random secret in production.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=3600s

# Super admin seed (consumed by `npm run prisma:seed`).
# Change these before seeding anything you intend to keep.
SUPER_ADMIN_EMAIL=superadmin@zoikomeds.io
SUPER_ADMIN_PASSWORD=ChangeMe!SuperAdmin1
SUPER_ADMIN_NAME=ZoikoMeds Super Admin

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Governance flags
EXPOSE_EXACT_STOCK=false

# Internet pharmacy search (Google Places API + Geocoding API).
# When a location is supplied, /search returns general pharmacies found nearby
# on the internet, separate from in-database availability. Requires a Google
# Cloud key with the "Places API (New)" and "Geocoding API" enabled.
# If left empty this feature is disabled and search still works normally.
GOOGLE_PLACES_API_KEY=

# Public app base URL — used to build links in outbound emails (reset/invite).
APP_BASE_URL=http://localhost:5173

# SMTP / outbound mail (credentials, invites, password resets).
# If SMTP_HOST is empty the backend uses a log-only mailer: emails (including
# reset links) are printed to the app log and nothing is actually sent — so
# local development works without any mail credentials.
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@zoikomeds.com
SMTP_FROM_NAME=ZoikoMeds
