# ZoikoMeds Backend — environment template. Copy to .env and fill in.

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Comma-separated list of allowed browser origins (Vite dev server is :5173).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zoikomeds?schema=public"

# Auth — JWT signing. Generate a unique secret per environment:
#   openssl rand -base64 48
# Required at boot; must be >= 32 chars in production. Known placeholder values
# (e.g. "change-me-in-production") are rejected. Inject from a secrets manager
# in production — never commit a real secret.
JWT_SECRET=
JWT_EXPIRES_IN=3600s

# Super admin seed (consumed by `npm run prisma:seed`).
# Change these before seeding anything you intend to keep.
SUPER_ADMIN_EMAIL=superadmin@zoikomeds.io
SUPER_ADMIN_PASSWORD=ChangeMe!SuperAdmin1
SUPER_ADMIN_NAME=ZoikoMeds Super Admin

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Governance flags
EXPOSE_EXACT_STOCK=false

# ZoikoSignal™ intelligence (aggregate-only, anonymized).
# k-anonymity threshold: aggregate cells / search terms below this many events
# are masked before any output. Minimum 2; default 5.
SIGNAL_K_ANONYMITY=5
# Days to retain raw (already-aggregated) events before pruning. Default 90.
SIGNAL_EVENT_RETENTION_DAYS=90
# Scheduled aggregation recompute. Off by default; the job can also be run
# on demand via POST /signal/admin/aggregate.
SIGNAL_AGGREGATION_ENABLED=false
SIGNAL_AGGREGATION_INTERVAL_MS=300000

# Internet pharmacy search (Google Places API + Geocoding API).
# When a location is supplied, /search returns general pharmacies found nearby
# on the internet, separate from in-database availability. Requires a Google
# Cloud key with the "Places API (New)" and "Geocoding API" enabled.
# If left empty this feature is disabled and search still works normally.
GOOGLE_PLACES_API_KEY=

# Public app base URL — used to build links in outbound emails (reset/invite)
# and as the default target the OAuth callbacks redirect back to.
APP_BASE_URL=http://localhost:5173

# OAuth / social sign-in (Google + Microsoft). Leave the client id/secret empty
# to disable a provider — its buttons still render but the endpoint returns 503
# and the app boots normally. Fill these in from each provider's console.
#
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client ID.
#   Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
#
# Azure Portal → App registrations → your app → Certificates & secrets / Redirect URIs.
#   MICROSOFT_TENANT: "common" (any account), "organizations", "consumers", or a tenant id.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:8000/api/auth/microsoft/callback
MICROSOFT_TENANT=common
#
# Where the OAuth callbacks send the browser after issuing a token.
# Defaults to ${APP_BASE_URL}/auth/callback when unset.
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback

# SMTP / outbound mail (credentials, invites, password resets).
# If SMTP_HOST is empty the backend uses a log-only mailer: emails (including
# reset links) are printed to the app log and nothing is actually sent — so
# local development works without any mail credentials.
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@zoikomeds.com
SMTP_FROM_NAME=ZoikoMeds
