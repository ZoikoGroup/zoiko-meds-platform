# ZoikoMeds Backend — environment template. Copy to .env and fill in.

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zoikomeds?schema=public"

# Auth — required at boot. Generate with `openssl rand -base64 48`.
# Must be >= 32 chars in production; known placeholders are rejected.
JWT_SECRET=
JWT_EXPIRES_IN=3600s

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Governance flags
EXPOSE_EXACT_STOCK=false

# Super admin seed. Change before seeding anything you intend to keep.
SUPER_ADMIN_EMAIL=superadmin@zoikomeds.io
SUPER_ADMIN_PASSWORD=ChangeMe!SuperAdmin1
SUPER_ADMIN_NAME=ZoikoMeds Super Admin
# Demo data (sample pharmacies, medicines, demo logins) is DESTRUCTIVE — it
# clears and reseeds tables. Never runs in production. Set false to skip.
SEED_DEMO_DATA=true

# ZoikoSignal™ — k-anonymity threshold; cells below this are masked. Minimum 2.
SIGNAL_K_ANONYMITY=5
SIGNAL_EVENT_RETENTION_DAYS=90
# Scheduled recompute. Off by default; also runnable via POST /signal/admin/aggregate.
SIGNAL_AGGREGATION_ENABLED=false
SIGNAL_AGGREGATION_INTERVAL_MS=300000

# Internet pharmacy search. Needs "Places API (New)" + "Geocoding API" enabled.
# Empty disables the feature; /search still works.
GOOGLE_PLACES_API_KEY=

# Public app base URL — the origin that serves the ZoikoMeds SPA. It builds
# every link in outbound email (password reset, invites, notifications) and is
# the default OAuth callback target, so it must be the app host and NOT the
# zoikomeds.com marketing site. Production example:
#   APP_BASE_URL=https://app.zoikomeds.com
# Required in production; boot fails if it is missing or points at localhost.
APP_BASE_URL=http://localhost:5173

# OAuth / social sign-in. Empty client id or secret disables that provider:
# its button still renders but the endpoint returns 503.
# Each provider's authorized redirect URI must match the callback below exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# MICROSOFT_TENANT: "common", "organizations", "consumers", or a tenant id.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:8000/api/auth/microsoft/callback
MICROSOFT_TENANT=common

# Where the browser lands after a successful OAuth sign-in. Must be the SPA's
# /auth/callback route (it adopts the token, then forwards to /dashboard).
# Defaults to ${APP_BASE_URL}/auth/callback when unset — leaving it empty in
# production is the safest option. Production example:
#   OAUTH_SUCCESS_REDIRECT=https://app.zoikomeds.com/auth/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback

# SMTP / outbound mail. Empty SMTP_HOST selects the log-only mailer: emails
# (including reset links) are printed to the app log and nothing is sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@zoikomeds.com
SMTP_FROM_NAME=ZoikoMeds
# Optional per-stream sender overrides. Fall back to SMTP_FROM_ADDRESS.
# SMTP_FROM_SECURITY / _LEGAL / _OPERATIONAL / _INTERNAL / _MARKETING / _NETWORK

# Notifications. Gates released for dispatch; CONDITIONAL covers commercial
# templates and needs commercial, tax, payment, refund and regulatory sign-off.
NOTIFICATION_RELEASED_GATES=P0,P1,P2,INTERNAL
# Extra hosts permitted in notification links. The APP_BASE_URL host is always allowed.
NOTIFICATION_ALLOWED_LINK_HOSTS=
SUPPORT_EMAIL=support@zoikomeds.com
# Defaults to ${APP_BASE_URL}/support when unset.
SUPPORT_CENTER_LINK=

# --- Commercial / billing (ZM-COM-BILL-001) --------------------------------
# Stripe is the named provider for self-serve Intelligence Pro. Leave unset to run
# with billing disabled: the availability network does not require charging.
# Use a TEST key (sk_test_...) everywhere except production.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint POST /api/commercial/webhooks/stripe.
# Without it, webhooks are rejected as unverified rather than trusted.
STRIPE_WEBHOOK_SECRET=
# Second, independent switch for live charging. A live key is NOT sufficient on its
# own. Enable only once the launch blockers close: approved price catalog per market
# and currency, verified merchant and bank beneficiary, tax registrations, and a
# reconciled contracting legal entity.
BILLING_LIVE_MODE=false

# --- Prescription scan — AI/Vision fallback --------------------------------
# Prescription OCR runs in the browser (Tesseract.js). This key powers only the
# fallback for prescriptions on-device OCR cannot read, exposed at
# POST /api/scan/vision-extract. Empty disables the feature: the endpoint
# reports available:false and the UI simply does not offer assisted reading.
# The key is server-side only and must never be given a VITE_ prefix — anything
# VITE_-prefixed is inlined into the public SPA bundle.
ANTHROPIC_API_KEY=
# Set false to disable the fallback without removing the key.
SCAN_VISION_ENABLED=true
SCAN_VISION_MODEL=claude-opus-5
