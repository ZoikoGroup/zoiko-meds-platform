// ZoikoMeds — Prisma schema (Tier-0 scaffold)
// Governed medicine availability infrastructure. This models the core entities
// referenced across the Master Build Reference: MediBase identity, pharmacy
// verification, availability signals, enterprise inquiries, and audit logging.
//
// NOTE: This is a scaffold. Fields, constraints, retention, and jurisdictional
// controls must be hardened against the Data Architecture & Governance spec
// before production use. It intentionally stores NO patient/PHI data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum UserRole {
  PUBLIC // patient / caregiver — the end-user portal
  PHARMACY_STAFF // "Pharmacist"
  PHARMACY_ADMIN // "Pharmacy Manager"
  ENTERPRISE // "Enterprise User"
  GOVERNMENT // "Government User"
  ADMIN // "Administrator"
  SUPER_ADMIN // platform owner — global override, sits atop every role
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String
  phone        String? // optional, for SMS availability alerts
  role         UserRole @default(PUBLIC)
  passwordHash String? // null for SSO/IdP-backed accounts
  pharmacyId   String?
  pharmacy     Pharmacy? @relation(fields: [pharmacyId], references: [id])
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(false) // set when an admin provisions an account
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  savedMedicines   SavedMedicine[]
  alertPreference  AlertPreference?
  searchHistory    SearchHistory[]
  passwordResets   PasswordResetToken[]

  @@index([role])
}

// ---------------------------------------------------------------------------
// Patient portal — personal, non-PHI data (saved meds, alert prefs, history)
// ---------------------------------------------------------------------------

model SavedMedicine {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   MedicineEntity @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([userId, medicineId])
  @@index([userId])
}

model AlertPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Keys mirror the patient Alerts screen toggles.
  backToHigh       Boolean  @default(true)
  nearby           Boolean  @default(true)
  confidenceChange Boolean  @default(false)
  shortage         Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  term      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// One-time password-reset tokens (hashed at rest). Also used for admin invites.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String    @default("reset") // "reset" | "invite"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Jurisdiction
// ---------------------------------------------------------------------------

model Jurisdiction {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. "GB", "US-CA"
  name          String
  regulatoryTag String?
  createdAt     DateTime @default(now())

  medicines  MedicineEntity[]
  pharmacies Pharmacy[]
}

// ---------------------------------------------------------------------------
// MediBase™ — canonical medicine identity & classification
// ---------------------------------------------------------------------------

enum QualityState {
  VERIFIED
  PARTNER_SUPPLIED
  MAPPED
  INFERRED
  NEEDS_REVIEW
  DEPRECATED
  SUPPRESSED
}

enum PrescriptionCategory {
  OTC
  PRESCRIPTION
  CONTROLLED
  RESTRICTED
  UNKNOWN
}

model MedicineEntity {
  id                   String               @id @default(cuid())
  canonicalName        String
  genericName          String?
  brandNames           String[]             @default([])
  manufacturer         String? // primary marketing-authorisation holder (public label)
  description          String? // short public-safe description shown in the patient portal
  activeIngredient     String?
  strength             String?
  dosageForm           String?
  route                String?
  presentation         String?
  atcCode              String?
  prescriptionCategory PrescriptionCategory @default(UNKNOWN)
  qualityState         QualityState         @default(NEEDS_REVIEW)
  isControlled         Boolean              @default(false)
  isSuppressed         Boolean              @default(false)
  schemaVersion        Int                  @default(1)

  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])

  identifiers        IdentifierMapping[]
  availabilitySignals AvailabilitySignal[]
  savedByUsers       SavedMedicine[]
  changeLogs         MedicineChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canonicalName])
  @@index([genericName])
  @@index([qualityState])
  @@index([isSuppressed])
}

// Field-level change history for governed medicine identities. Every MediBase
// mutation (create, curation edit, quality-state transition, identifier change)
// appends an immutable entry here so the governance change-log is auditable and
// schema-version aware. Distinct from the platform-wide AuditLog: this is the
// data-lineage trail for a single medicine entity.
model MedicineChangeLog {
  id            String         @id @default(cuid())
  medicineId    String
  medicine      MedicineEntity @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  action        String // "create" | "update" | "state_transition" | "identifier.add" | "identifier.remove"
  field         String? // affected field, where the change is scoped to one
  previousValue Json?
  newValue      Json?
  fromState     QualityState?
  toState       QualityState?
  schemaVersion Int            @default(1)
  actorId       String?
  actorEmail    String? // denormalized for fast display
  note          String?
  createdAt     DateTime       @default(now())

  @@index([medicineId, createdAt])
  @@index([action])
}

// Maps a medicine entity to external identifiers (NDC, RxCUI, GTIN, DIN, dm+d, EAN/UPC, local codes)
model IdentifierMapping {
  id           String       @id @default(cuid())
  medicineId   String
  medicine     MedicineEntity @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  system       String // e.g. "NDC", "RXCUI", "GTIN", "DIN", "DMD", "ATC", "LOCAL"
  value        String
  qualityState QualityState @default(MAPPED)
  source       String?
  licenseScope String?
  createdAt    DateTime     @default(now())

  @@unique([system, value, medicineId])
  @@index([system, value])
}

// ---------------------------------------------------------------------------
// Pharmacy verification & participation
// ---------------------------------------------------------------------------

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

enum UploadMethod {
  MANUAL
  CSV
  API
  POS_INTEGRATION
}

model Pharmacy {
  id                 String             @id @default(cuid())
  name               String
  licenseNumber      String? // regulatory license identifier
  addressLine1       String?
  addressLine2       String?
  city               String?
  region             String?
  country            String?
  postalCode         String?
  latitude           Float?
  longitude          Float?
  phone              String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  reliabilityScore   Float              @default(0) // 0..1, drives ZoikoAvail confidence
  isParticipating    Boolean            @default(false)

  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])

  users              User[]
  inventorySignals   InventorySignal[]
  availabilitySignals AvailabilitySignal[]
  verificationRequests VerificationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
  @@index([latitude, longitude])
}

// Raw inventory signal uploaded by a pharmacy. NEVER exposed publicly as exact stock.
model InventorySignal {
  id           String       @id @default(cuid())
  pharmacyId   String
  pharmacy     Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId   String
  uploadMethod UploadMethod @default(MANUAL)
  // Confidential — internal only. Public surfaces use derived AvailabilitySignal.
  quantityOnHand Int?
  reportedInStock Boolean   @default(true)
  reportedAt   DateTime     @default(now())
  createdAt    DateTime     @default(now())

  @@index([pharmacyId, medicineId])
  @@index([reportedAt])
}

// ---------------------------------------------------------------------------
// ZoikoAvail™ — derived availability confidence signal (public-safe)
// ---------------------------------------------------------------------------

enum AvailabilityConfidence {
  HIGH
  MODERATE
  LOW
  UNKNOWN
  SUPPRESSED
}

model AvailabilitySignal {
  id            String                 @id @default(cuid())
  medicineId    String
  medicine      MedicineEntity         @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  pharmacyId    String
  pharmacy      Pharmacy               @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  confidence    AvailabilityConfidence @default(UNKNOWN)
  freshnessMinutes Int? // age of the underlying signal
  requiresConfirmation Boolean         @default(false)
  computedAt    DateTime               @default(now())

  @@unique([medicineId, pharmacyId])
  @@index([medicineId])
  @@index([confidence])
}

// ---------------------------------------------------------------------------
// ZoikoSignal™ — aggregated, anonymized demand/shortage intelligence
// ---------------------------------------------------------------------------

model SignalAggregate {
  id             String   @id @default(cuid())
  medicineId     String?
  jurisdictionId String?
  periodStart    DateTime
  periodEnd      DateTime
  searchCount    Int      @default(0)
  zeroResultCount Int     @default(0)
  restockEvents  Int      @default(0)
  // Aggregated only — no user-level or patient-level data.
  createdAt      DateTime @default(now())

  @@index([medicineId, periodStart])
}

// ---------------------------------------------------------------------------
// Enterprise inquiries (MediBase briefing, ZoikoAvail API access, etc.)
// ---------------------------------------------------------------------------

enum InquiryType {
  MEDIBASE_BRIEFING
  API_ACCESS
  DATA_LICENSING
  SECURITY_REVIEW
  IMPLEMENTATION_WORKSHOP
  GENERAL
}

enum InquiryStatus {
  NEW
  ROUTED
  QUALIFIED
  IN_REVIEW
  CLOSED
}

model EnterpriseInquiry {
  id               String        @id @default(cuid())
  type             InquiryType   @default(GENERAL)
  workEmail        String
  fullName         String
  organizationName String
  organizationType String
  primaryInterest  String?
  note             String?
  requestSource    String?
  assignedQueue    String?
  status           InquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([type, status])
}

// ---------------------------------------------------------------------------
// Audit log (governance/observability)
// ---------------------------------------------------------------------------

enum AuditSeverity {
  INFO
  WARNING
  SECURITY_ALERT
}

model AuditLog {
  id         String        @id @default(cuid())
  actorId    String?
  actorEmail String? // denormalized for fast display in the admin console
  action     String
  entityType String? // surfaced as "module" in the admin UI
  entityId   String?
  severity   AuditSeverity @default(INFO)
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime      @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([severity])
}

// ---------------------------------------------------------------------------
// Verification Center — pharmacy license/verification review queue
// ---------------------------------------------------------------------------

enum VerificationRequestStatus {
  PENDING
  UNDER_REVIEW
  ESCALATED
  APPROVED
  REJECTED
  REQUEST_INFO
}

model VerificationRequest {
  id            String                    @id @default(cuid())
  pharmacyId    String?
  pharmacy      Pharmacy?                  @relation(fields: [pharmacyId], references: [id])
  pharmacyName  String // denormalized label for display
  licenseNumber String
  submittedBy   String
  status        VerificationRequestStatus @default(PENDING)
  reviewer      String?
  docName       String?
  docUrl        String?
  notes         String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Notifications / broadcasts (admin → audiences)
// ---------------------------------------------------------------------------

enum NotificationType {
  PLATFORM_UPDATE
  MAINTENANCE
  EMERGENCY_ALERT
  SYSTEM_ANNOUNCEMENT
}

enum NotificationTarget {
  ALL_USERS
  PHARMACY_MANAGERS
  ENTERPRISE_ADMINS
  GOVERNMENT_PARTNERS
}

enum NotificationStatus {
  DRAFT
  DISPATCHED
}

model Notification {
  id        String             @id @default(cuid())
  title     String
  message   String
  type      NotificationType   @default(SYSTEM_ANNOUNCEMENT)
  target    NotificationTarget @default(ALL_USERS)
  status    NotificationStatus @default(DRAFT)
  createdBy String?
  createdAt DateTime           @default(now())

  @@index([status])
  @@index([type])
}
