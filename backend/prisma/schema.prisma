// ZoikoMeds — Prisma schema (Tier-0 scaffold)
// Governed medicine availability infrastructure. This models the core entities
// referenced across the Master Build Reference: MediBase identity, pharmacy
// verification, availability signals, enterprise inquiries, and audit logging.
//
// NOTE: This is a scaffold. Fields, constraints, retention, and jurisdictional
// controls must be hardened against the Data Architecture & Governance spec
// before production use. It intentionally stores NO patient/PHI data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum UserRole {
  PUBLIC // patient / caregiver — the end-user portal
  PHARMACY_STAFF // "Pharmacist"
  PHARMACY_ADMIN // "Pharmacy Manager"
  ENTERPRISE // "Enterprise User"
  GOVERNMENT // "Government User"
  ADMIN // "Administrator"
  SUPER_ADMIN // platform owner — global override, sits atop every role
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  fullName           String
  phone              String? // optional, for SMS availability alerts
  role               UserRole  @default(PUBLIC)
  passwordHash       String? // null for SSO/IdP-backed accounts
  pharmacyId         String?
  pharmacy           Pharmacy? @relation(fields: [pharmacyId], references: [id])
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false) // set when an admin provisions an account
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  savedMedicines               SavedMedicine[]
  alertPreference              AlertPreference?
  searchHistory                SearchHistory[]
  passwordResets               PasswordResetToken[]
  signalNotifications          SignalNotification[]
  signalNotificationPreference SignalNotificationPreference?
  capabilityGrants             CapabilityGrant[]             @relation("CapabilityGrantUser")
  capabilityGrantsIssued       CapabilityGrant[]             @relation("CapabilityGrantIssuer")
  organizationsUpdated         Organization[]                @relation("OrganizationUpdatedBy")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Patient portal — personal, non-PHI data (saved meds, alert prefs, history)
// ---------------------------------------------------------------------------

// Priority a patient assigns to a saved medicine — drives ordering + alert
// emphasis on the ZoikoSignal™ patient surface.
enum MedicinePriority {
  HIGH
  MEDIUM
  LOW
}

model SavedMedicine {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Null while the medicine is not yet in MediBase. A patient may follow a
  // medicine the catalog has never seen (e.g. a brand only stocked locally);
  // the row is linked to a governed identity later, the first time a verified
  // pharmacy adds it. onDelete: SetNull so retiring a medicine downgrades the
  // save back to name-only rather than silently discarding it.
  medicineId String?
  medicine   MedicineEntity? @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  // What the patient saved, as written — always present, and the display name
  // until a governed identity is attached.
  medicineName   String
  // Case/spacing/punctuation-insensitive form of medicineName. The matching key
  // for off-catalog rows, and the per-user uniqueness key for every row.
  normalizedName String

  priority       MedicinePriority @default(MEDIUM)
  alertsEnabled  Boolean          @default(true)
  // Last availability status a notification was generated for. Lets the signal
  // generator detect transitions (e.g. running-low → back-in-stock) instead of
  // re-emitting the same state. One of: available|limited|running-low|out-of-stock.
  notifiedStatus String?
  // Set when a pharmacy first brings this medicine into the catalog, so the
  // "now available" alert is emitted once and never re-fired.
  linkedAt       DateTime?
  createdAt      DateTime         @default(now())

  // Uniqueness is on the normalized name, not medicineId: a nullable FK would
  // let Postgres treat every unlinked row as distinct, so the same patient
  // could save "Volini Gel" repeatedly.
  @@unique([userId, normalizedName])
  @@index([userId])
  @@index([normalizedName, medicineId])
}

model AlertPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Keys mirror the patient Alerts screen toggles.
  backToHigh       Boolean  @default(true)
  nearby           Boolean  @default(true)
  confidenceChange Boolean  @default(false)
  shortage         Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  term      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// One-time password-reset tokens (hashed at rest). Also used for admin invites.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String    @default("reset") // "reset" | "invite"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Jurisdiction
// ---------------------------------------------------------------------------

model Jurisdiction {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. "GB", "US-CA"
  name          String
  regulatoryTag String?
  createdAt     DateTime @default(now())

  medicines  MedicineEntity[]
  pharmacies Pharmacy[]
}

// ---------------------------------------------------------------------------
// MediBase™ — canonical medicine identity & classification
// ---------------------------------------------------------------------------

enum QualityState {
  VERIFIED
  PARTNER_SUPPLIED
  MAPPED
  INFERRED
  NEEDS_REVIEW
  DEPRECATED
  SUPPRESSED
}

enum PrescriptionCategory {
  OTC
  PRESCRIPTION
  CONTROLLED
  RESTRICTED
  UNKNOWN
}

model MedicineEntity {
  id                   String               @id @default(cuid())
  canonicalName        String
  genericName          String?
  brandNames           String[]             @default([])
  manufacturer         String? // primary marketing-authorisation holder (public label)
  description          String? // short public-safe description shown in the patient portal
  activeIngredient     String?
  strength             String?
  dosageForm           String?
  route                String?
  presentation         String?
  atcCode              String?
  prescriptionCategory PrescriptionCategory @default(UNKNOWN)
  qualityState         QualityState         @default(NEEDS_REVIEW)
  isControlled         Boolean              @default(false)
  isSuppressed         Boolean              @default(false)
  schemaVersion        Int                  @default(1)

  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])

  identifiers         IdentifierMapping[]
  availabilitySignals AvailabilitySignal[]
  savedByUsers        SavedMedicine[]
  changeLogs          MedicineChangeLog[]
  signalNotifications SignalNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canonicalName])
  @@index([genericName])
  @@index([qualityState])
  @@index([isSuppressed])
}

// Field-level change history for governed medicine identities. Every MediBase
// mutation (create, curation edit, quality-state transition, identifier change)
// appends an immutable entry here so the governance change-log is auditable and
// schema-version aware. Distinct from the platform-wide AuditLog: this is the
// data-lineage trail for a single medicine entity.
model MedicineChangeLog {
  id            String         @id @default(cuid())
  medicineId    String
  medicine      MedicineEntity @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  action        String // "create" | "update" | "state_transition" | "identifier.add" | "identifier.remove"
  field         String? // affected field, where the change is scoped to one
  previousValue Json?
  newValue      Json?
  fromState     QualityState?
  toState       QualityState?
  schemaVersion Int            @default(1)
  actorId       String?
  actorEmail    String? // denormalized for fast display
  note          String?
  createdAt     DateTime       @default(now())

  @@index([medicineId, createdAt])
  @@index([action])
}

// Maps a medicine entity to external identifiers (NDC, RxCUI, GTIN, DIN, dm+d, EAN/UPC, local codes)
model IdentifierMapping {
  id           String         @id @default(cuid())
  medicineId   String
  medicine     MedicineEntity @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  system       String // e.g. "NDC", "RXCUI", "GTIN", "DIN", "DMD", "ATC", "LOCAL"
  value        String
  qualityState QualityState   @default(MAPPED)
  source       String?
  licenseScope String?
  createdAt    DateTime       @default(now())

  @@unique([system, value, medicineId])
  @@index([system, value])
}

// ---------------------------------------------------------------------------
// Pharmacy verification & participation
// ---------------------------------------------------------------------------

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
  INFO_REQUESTED
}

enum UploadMethod {
  MANUAL
  CSV
  API
  POS_INTEGRATION
}

model Pharmacy {
  id                 String             @id @default(cuid())
  name               String
  licenseNumber      String? // regulatory license identifier
  addressLine1       String?
  addressLine2       String?
  city               String?
  region             String?
  country            String?
  postalCode         String?
  latitude           Float?
  longitude          Float?
  phone              String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  reliabilityScore   Float              @default(0) // 0..1, drives ZoikoAvail confidence
  isParticipating    Boolean            @default(false)

  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])

  users                User[]
  inventorySignals     InventorySignal[]
  availabilitySignals  AvailabilitySignal[]
  verificationRequests VerificationRequest[]

  /// The logo image itself lives in its own table so it is never loaded by the
  /// queries that matter: patient search reads this row, and Prisma selects every
  /// scalar it holds by default.
  logo PharmacyLogo?

  /// Set whenever the logo changes. Denormalized on purpose - a list response can
  /// then say whether a pharmacy has a logo, and cache-bust its URL, without
  /// joining a table of image bytes.
  logoUpdatedAt DateTime?

  /// Commercial classification, deliberately separate from verificationStatus:
  /// eligibility and billability are different questions (ZM-COM-BILL-001 S-B1).
  /// Defaults to the non-billable directory state so a preloaded record can
  /// never become a paying customer merely because billing launched (S-Q1).
  commercialClassification CommercialClassification @default(DIRECTORY_UNCLAIMED)
  subscriptionLocations    SubscriptionLocation[]

  /// POS/ERP feed configuration, one per pharmacy. Optional: a pharmacy that
  /// maintains stock by hand simply has no row here.
  integration PharmacyIntegration?
  syncRuns    PharmacySyncRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
  @@index([latitude, longitude])
}

/// A pharmacy's logo, kept out of the Pharmacy row deliberately.
///
/// Bytes in the database rather than an object store: it needs no bucket, no
/// credentials and no volume, so a logo works on any deployment of this repo. The
/// size cap in PharmacyLogoService is what keeps that honest. This model and that
/// service are the whole storage seam - moving to a bucket means writing the URL
/// here instead of the bytes, and nothing above them changes.
model PharmacyLogo {
  pharmacyId String   @id
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  data     Bytes
  /// Sniffed from the file's own leading bytes, never taken from the upload's
  /// declared content type, and it is what the download route replays.
  mimeType String
  byteSize Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Raw inventory signal uploaded by a pharmacy. NEVER exposed publicly as exact stock.
model InventorySignal {
  id              String       @id @default(cuid())
  pharmacyId      String
  pharmacy        Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId      String
  uploadMethod    UploadMethod @default(MANUAL)
  // Confidential — internal only. Public surfaces use derived AvailabilitySignal.
  quantityOnHand  Int?
  reportedInStock Boolean      @default(true)
  reportedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@index([pharmacyId, medicineId])
  @@index([reportedAt])
}

// ---------------------------------------------------------------------------
// ZoikoAvail™ — derived availability confidence signal (public-safe)
// ---------------------------------------------------------------------------

enum AvailabilityConfidence {
  HIGH
  MODERATE
  LOW
  UNKNOWN
  SUPPRESSED
}

model AvailabilitySignal {
  id                   String                 @id @default(cuid())
  medicineId           String
  medicine             MedicineEntity         @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  pharmacyId           String
  pharmacy             Pharmacy               @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  confidence           AvailabilityConfidence @default(UNKNOWN)
  freshnessMinutes     Int? // age of the underlying signal
  requiresConfirmation Boolean                @default(false)
  computedAt           DateTime               @default(now())

  @@unique([medicineId, pharmacyId])
  @@index([medicineId])
  @@index([confidence])
}

// ---------------------------------------------------------------------------
// ZoikoSignal™ — aggregated, anonymized demand/shortage intelligence
// ---------------------------------------------------------------------------

// Category of an ingested intelligence event. Deliberately coarse: an event
// records WHAT happened and (optionally) which governed medicine/jurisdiction
// it concerned — NEVER who triggered it.
enum SignalEventType {
  SEARCH // a medicine search was performed
  ZERO_RESULT // a search returned no governed identity
  RESTOCK // a pharmacy reported a medicine back in stock
  CONFIRMATION // an availability signal was confirmed
}

// Time granularity for a SignalAggregate cell.
enum AggregateBucket {
  HOUR
  DAY
  WEEK
}

// Raw, anonymized intelligence event. This is the ingestion substrate that the
// aggregation job folds into time-bucketed SignalAggregate cells.
//
// GOVERNANCE: stores NO userId, session, IP, or any patient identifier. The
// only free-text retained is a normalized, length-capped search term on
// ZERO_RESULT events (used solely to surface unmet demand in aggregate, never
// tied to a person). Raw events are pruned after a short retention window once
// they have been aggregated.
model SignalEvent {
  id             String          @id @default(cuid())
  type           SignalEventType
  medicineId     String? // governed identity, when one was resolved
  jurisdictionId String? // denormalized from the medicine at ingest, for scoped rollups
  pharmacyId     String? // present for RESTOCK / CONFIRMATION; never exposed downstream
  searchTerm     String? // normalized term for ZERO_RESULT demand analysis (no PII)
  occurredAt     DateTime        @default(now())
  // Set once the event has been folded into an aggregate. Null = pending.
  aggregatedAt   DateTime?
  createdAt      DateTime        @default(now())

  @@index([aggregatedAt])
  @@index([type, occurredAt])
  @@index([medicineId, occurredAt])
  @@index([type, aggregatedAt])
}

model SignalAggregate {
  id                String          @id @default(cuid())
  medicineId        String?
  jurisdictionId    String?
  bucket            AggregateBucket @default(DAY)
  periodStart       DateTime
  periodEnd         DateTime
  searchCount       Int             @default(0)
  zeroResultCount   Int             @default(0)
  restockEvents     Int             @default(0)
  confirmationCount Int             @default(0)
  // Total events backing this cell — drives the k-anonymity suppression gate.
  sampleSize        Int             @default(0)
  // True when sampleSize is below the k-anonymity threshold: the cell exists
  // but its counts must be masked before any output leaves the service.
  suppressed        Boolean         @default(false)
  // Aggregated only — no user-level or patient-level data.
  createdAt         DateTime        @default(now())
  // @default(now()) alongside @updatedAt because the column was created with
  // DEFAULT CURRENT_TIMESTAMP (20260716120000_zoikosignal_intelligence) and the
  // datamodel never said so. Declaring what the database already has costs
  // nothing and needs no DDL; the alternative was altering a production table
  // to erase a default that @updatedAt makes unreachable anyway.
  updatedAt         DateTime        @default(now()) @updatedAt

  // The map is the name Postgres actually gave this index, not the one the
  // migration asked for. 0_init's successor wrote
  // "SignalAggregate_medicineId_jurisdictionId_bucket_periodStart_key" — 64
  // characters — and Postgres silently truncated it to 63, taking the "_key"
  // suffix with it. Prisma's own convention shortens the middle instead, so it
  // expects "..._periodStar_key" and reads the difference as schema drift.
  // Naming the real index here is a no-op against every existing database.
  @@unique([medicineId, jurisdictionId, bucket, periodStart], map: "SignalAggregate_medicineId_jurisdictionId_bucket_periodStart_ke")
  @@index([medicineId, periodStart])
  @@index([bucket, periodStart])
  @@index([suppressed])
}

// ---------------------------------------------------------------------------
// Enterprise inquiries (MediBase briefing, ZoikoAvail API access, etc.)
// ---------------------------------------------------------------------------

enum InquiryType {
  MEDIBASE_BRIEFING
  API_ACCESS
  DATA_LICENSING
  SECURITY_REVIEW
  IMPLEMENTATION_WORKSHOP
  GENERAL
}

enum InquiryStatus {
  NEW
  ROUTED
  QUALIFIED
  IN_REVIEW
  CLOSED
}

model EnterpriseInquiry {
  id               String        @id @default(cuid())
  type             InquiryType   @default(GENERAL)
  workEmail        String
  fullName         String
  organizationName String
  organizationType String
  primaryInterest  String?
  note             String?
  requestSource    String?
  assignedQueue    String?
  status           InquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([type, status])
}

// ---------------------------------------------------------------------------
// Audit log (governance/observability)
// ---------------------------------------------------------------------------

enum AuditSeverity {
  INFO
  WARNING
  SECURITY_ALERT
}

/// The workspace's own profile: the single organization this deployment is run by.
///
/// The settings page showed "Meridian Health Network / org-meridian / North
/// America (us-east)" to every super admin and its Save button had no handler,
/// because there was nothing anywhere in the schema for it to write to (MSA-40).
///
/// One row, pinned by `id`. A settings table with no key invites a second row
/// that nothing reads, and then the question of which one is live.
model Organization {
  /// Always SINGLETON_ID. The check constraint lives in the migration.
  id               String  @id
  name             String
  /// Stable external handle. Not the primary key: an operator renaming the
  /// workspace must not change what the row is.
  slug             String  @unique
  /// Where this deployment's data is held. Free text because it describes a
  /// hosting decision made outside the application, not something it enforces.
  dataResidency    String?
  organizationType String?

  updatedAt   DateTime @updatedAt
  /// Who last saved it, for the settings page to show and the audit log to match.
  updatedById String?
  updatedBy   User?    @relation("OrganizationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String        @id @default(cuid())
  actorId    String?
  actorEmail String? // denormalized for fast display in the admin console
  action     String
  entityType String? // surfaced as "module" in the admin UI
  entityId   String?
  severity   AuditSeverity @default(INFO)
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime      @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([severity])
}

// ---------------------------------------------------------------------------
// Verification Center — pharmacy license/verification review queue
// ---------------------------------------------------------------------------

enum VerificationRequestStatus {
  PENDING
  UNDER_REVIEW
  ESCALATED
  APPROVED
  REJECTED
  REQUEST_INFO
}

model VerificationRequest {
  id            String                    @id @default(cuid())
  pharmacyId    String?
  pharmacy      Pharmacy?                 @relation(fields: [pharmacyId], references: [id])
  pharmacyName  String // denormalized label for display
  licenseNumber String
  submittedBy   String
  status        VerificationRequestStatus @default(PENDING)
  reviewer      String?
  docName       String?
  docUrl        String?
  notes         String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Notifications / broadcasts (admin → audiences)
// ---------------------------------------------------------------------------

enum NotificationType {
  PLATFORM_UPDATE
  MAINTENANCE
  EMERGENCY_ALERT
  SYSTEM_ANNOUNCEMENT
}

enum NotificationTarget {
  ALL_USERS
  PHARMACY_MANAGERS
  ENTERPRISE_ADMINS
  GOVERNMENT_PARTNERS
}

enum NotificationStatus {
  DRAFT
  DISPATCHED
}

model Notification {
  id        String             @id @default(cuid())
  title     String
  message   String
  type      NotificationType   @default(SYSTEM_ANNOUNCEMENT)
  target    NotificationTarget @default(ALL_USERS)
  status    NotificationStatus @default(DRAFT)
  createdBy String?
  createdAt DateTime           @default(now())

  @@index([status])
  @@index([type])
}

// ---------------------------------------------------------------------------
// ZoikoSignal™ — patient notifications (personal availability alerts)
// ---------------------------------------------------------------------------

// Kind of personal availability notification shown on the patient ZoikoSignal
// surface. Availability kinds are derived from a saved medicine's confidence
// band; RECALL / SAFETY are fanned out from dispatched platform broadcasts.
enum SignalNotificationType {
  RUNNING_LOW
  BACK_IN_STOCK
  LIMITED
  NEARBY_RESTOCK
  RECALL
  SAFETY
}

// A single, per-user ZoikoSignal notification. Rows are (re)generated from the
// user's saved-medicine availability signals and relevant platform broadcasts;
// `dedupeKey` makes generation idempotent so read/archived/dismissed state is
// preserved across regenerations. Personal to a user — never aggregate/PHI-free
// intelligence (that is SignalAggregate).
model SignalNotification {
  id           String                 @id @default(cuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stable identity for a logical notification (e.g. "med:<id>:running-low" or
  // "broadcast:<id>") so regeneration upserts in place.
  dedupeKey    String
  type         SignalNotificationType
  medicineId   String?
  medicine     MedicineEntity?        @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName String
  title        String
  description  String
  actionLabel  String?
  actionKind   String?
  actionQuery  String?
  read         Boolean                @default(false)
  archived     Boolean                @default(false)
  dismissed    Boolean                @default(false)
  occurredAt   DateTime               @default(now())
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([userId, dedupeKey])
  @@index([userId, dismissed, archived])
}

// Patient notification-channel + category preferences. Mirrors the toggles on
// the ZoikoSignal settings card. Distinct from AlertPreference (the availability
// Alerts screen) so each surface owns its own vocabulary.
model SignalNotificationPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runningLow    Boolean  @default(true)
  backInStock   Boolean  @default(true)
  nearbyRestock Boolean  @default(true)
  recall        Boolean  @default(true)
  safety        Boolean  @default(true)
  push          Boolean  @default(true)
  email         Boolean  @default(false)
  sms           Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Reports — saved & scheduled governed exports surfaced in the admin console
// ---------------------------------------------------------------------------

enum ReportType {
  EXECUTIVE_BRIEFING
  REGIONAL_DIGEST
  GOVERNANCE_EXPORT
  NETWORK_REPORT
  OPERATIONS
  DATA_QUALITY
  FORECAST
}

enum ReportFormat {
  PDF
  CSV
  XLSX
  JSON
}

// The intelligence surface a report draws from — mirrors the export-center scope.
enum ReportScope {
  ALL
  SIGNAL
  JURISDICTION
  NETWORK
}

enum ReportStatus {
  READY
  SCHEDULED
  RUNNING
  FAILED
}

model Report {
  id        String       @id @default(cuid())
  name      String
  type      ReportType   @default(EXECUTIVE_BRIEFING)
  format    ReportFormat @default(PDF)
  scope     ReportScope  @default(ALL)
  status    ReportStatus @default(READY)
  owner     String // denormalized creator label (email) for fast display
  createdBy String // actor email that generated the report
  // Human-readable cadence for scheduled reports (e.g. "Daily · 06:00"); null for one-off.
  schedule  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@index([type])
}

// ---------------------------------------------------------------------------
// ZM-NOT-EMAIL-02 — governed notification delivery
//
// Implements the engineering rules of the email template library: one immutable
// event per committed state transition, channels rendered from that record, and
// a full delivery audit trail. Templates themselves live in code
// (src/modules/notifications/catalog) — the database stores what was emitted,
// never the copy.
// ---------------------------------------------------------------------------

// Delivery stream. Streams are dispatched and reputation-monitored separately so
// a marketing complaint can never degrade security or legal deliverability.
enum NotificationStream {
  TRANSACTIONAL
  SECURITY
  LEGAL
  OPERATIONAL
  INTERNAL
  MARKETING
}

// Release gate from the template directory. Only ACTIVE templates may dispatch;
// CONDITIONAL covers the commercial set, which stays disabled until the
// commercial, tax, payment, refund, and regulatory owners sign off.
enum NotificationGate {
  P0
  P1
  P2
  INTERNAL
  CONDITIONAL
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

// Why a delivery was not attempted. Recorded per the audit rule so suppression is
// always explainable after the fact.
enum NotificationSuppressionReason {
  TEMPLATE_NOT_ACTIVE
  GATE_NOT_RELEASED
  RECIPIENT_UNSUBSCRIBED
  RECIPIENT_BOUNCED
  RECIPIENT_COMPLAINED
  NO_RESOLVED_RECIPIENT
  DUPLICATE_EVENT
  STATE_REVALIDATION_FAILED
}

// An immutable record of an authoritative state transition worth notifying about.
// Created once, never updated: corrections are new events. `idempotencyKey` is
// derived from the workflow reference plus template so retries of the same
// transition collapse onto one row instead of re-sending.
model NotificationEvent {
  id              String             @id @default(cuid())
  templateId      String // e.g. "REG-004"
  templateVersion String
  baseEvent       String // e.g. "REG-004" — the approved base event the variant maps to
  stream          NotificationStream
  gate            NotificationGate
  idempotencyKey  String             @unique
  // Reference to the workflow record that caused this event (application id,
  // verification request id, support case id, …).
  workflowRef     String?
  workflowType    String?
  // Validated merge data for the template. Must contain every required field the
  // template declares; the renderer refuses to render otherwise.
  payload         Json
  locale          String             @default("en-US")
  // Actor that caused an administrator-generated event; null for system events.
  actorId         String?
  actorEmail      String?
  occurredAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())

  deliveries NotificationDelivery[]

  @@index([templateId])
  @@index([workflowType, workflowRef])
  @@index([occurredAt])
}

// One row per (event, channel, recipient). Holds the delivery audit trail the
// spec requires: provider id, timestamps, status, suppression reason, retries.
model NotificationDelivery {
  id                  String                         @id @default(cuid())
  eventId             String
  event               NotificationEvent              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channel             NotificationChannel
  // Masked at rest for the audit view; the full address is resolved at send time.
  recipientEmail      String?
  recipientUserId     String?
  // How the recipient was determined (e.g. "application.primaryContact") so a
  // misdirected message can be traced back to its resolution rule.
  recipientResolution String
  senderAddress       String?
  status              NotificationDeliveryStatus     @default(PENDING)
  suppressionReason   NotificationSuppressionReason?
  providerMessageId   String?
  attempts            Int                            @default(0)
  lastError           String?
  sentAt              DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  @@index([eventId])
  @@index([status])
  @@index([recipientUserId])
}

// Address-level delivery suppression. Essential streams (SECURITY, LEGAL,
// TRANSACTIONAL) ignore UNSUBSCRIBED entries — per the rule that users may not
// opt out of communications required for an enabled workflow — but always honor
// hard bounces and complaints.
model NotificationSuppression {
  id        String                        @id @default(cuid())
  email     String                        @unique
  reason    NotificationSuppressionReason
  note      String?
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt

  @@index([reason])
}

// ---------------------------------------------------------------------------
// Commercial: billing, subscriptions & network participation
// ZM-COM-BILL-001 v1.0
//
// Doctrine constraints encoded structurally here rather than left to callers:
//  - Billing identity is the legal organization/location, deliberately separate
//    from patient identity, which never acquires a billing profile.
//  - Prices are catalog records, never source constants. A price referenced by a
//    finalized invoice is immutable; a change is a new version (S21, S-P4).
//  - Only a verified location on a commercial classification can be charged.
//    Directory, pending, pilot, internal, demo, QA and sandbox records are
//    non-billable by construction (S-Q1).
//  - Usage counts once per idempotency key, and only for delivered,
//    policy-permitted output (S-J3, S-K2).
// ---------------------------------------------------------------------------

/// Commercial classification of a pharmacy location. Distinct from
/// VerificationStatus, which is eligibility: a location may be verified yet
/// non-billable, or paid yet operationally restricted (S-B1, S-Q1).
enum CommercialClassification {
  DIRECTORY_UNCLAIMED // preloaded record, nobody has claimed it
  CLAIMED_PENDING // claimed, authority not yet proven
  VERIFICATION_IN_REVIEW
  VERIFIED_NETWORK_CORE // verified, participating, zero cost (S-D1)
  PRO_EVALUATION // time-boxed, no card, never auto-converts (S-E3)
  PRO_ACTIVE // billable
  ENTERPRISE_CONTRACT_ACTIVE // billable under an Order Form
  PILOT_NON_BILLABLE
  INTERNAL
  DEMO
  QA
  STAGING
  PARTNER_SANDBOX
  SUSPENDED_COMPLIANCE
  REJECTED
  CLOSED
}

/// Commercial offers. Free access is modelled explicitly so that "free" is a
/// deliberate catalog state rather than the absence of a record.
enum CommercialOffer {
  PATIENT_CAREGIVER_ACCESS // zero cost (S-A1)
  PHARMACY_NETWORK_CORE // zero cost during the supply-density phase (S-D1)
  PHARMACY_INTELLIGENCE_PRO // per verified paid location (S-C1)
  ENTERPRISE_API_DATA // contract-defined (S-F2)
}

enum BillingInterval {
  MONTH
  YEAR
  CONTRACT_DEFINED
}

/// How a commercial record reached the platform. Mobile is tracked separately
/// because App Store rules constrain what may be sold in-app (S-O2).
enum BillingChannel {
  WEB_SELF_SERVE
  SALES_CONTRACT
  MOBILE_COMPANION_ENTITLEMENT
}

enum SubscriptionState {
  EVALUATION
  ACTIVE
  PAST_DUE // payment failed, recovery in progress (S-L1)
  EXPANSION_BLOCKED // day 7: no new paid locations
  PAID_FEATURES_RESTRICTED // day 14: exports and advanced actions off
  CANCELED // downgraded to Network Core
  ELIGIBILITY_RESTRICTED // verification lapsed; cannot renew (S-B4)
}

/// Why usage was excluded from billing. Persisted rather than inferred so a
/// dispute can be answered from the record (S-K2).
enum UsageExclusionReason {
  PLATFORM_ERROR // ZoikoMeds 5xx, never billable
  CLIENT_ERROR // 4xx, rate-limit telemetry only, not paid usage
  DUPLICATE // idempotency key already seen
  DENIED_BY_POLICY
  CANCELED
  NOT_METERED // contract has no usage billing enabled
  SYNC_OR_PARSE_FAILURE // failed inventory feed (S-H1)
}

/// Capabilities that can be granted to a user on top of their role. Lets a
/// SUPER_ADMIN delegate specific authority without handing over the whole role,
/// and keeps billing authority separable from verification and inventory
/// authority (S-22).
enum BillingCapability {
  VIEW_PLAN_AND_USAGE
  MANAGE_PAYMENT_METHODS
  CHANGE_PLAN
  CANCEL_SUBSCRIPTION
  APPROVE_REFUND_OR_CREDIT
  MANAGE_DISCOUNTS_AND_ADDONS
  VIEW_INVOICES
  MANAGE_PRICE_CATALOG
  GRANT_CAPABILITIES
}

/// An explicit capability grant. SUPER_ADMIN bypasses these entirely; every
/// other role must be granted authority, and each grant records who issued it.
model CapabilityGrant {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation("CapabilityGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  capability       BillingCapability
  /// Null means platform-wide; set to scope the grant to one organization.
  billingProfileId String?
  /// Non-null mirror of the scope, used for uniqueness: the billingProfileId, or
  /// the literal "PLATFORM" for a platform-wide grant. Required because Postgres
  /// treats NULL as distinct in a unique index, so keying uniqueness on the
  /// nullable column would let duplicate platform-wide grants accumulate for the
  /// same user and capability.
  scopeKey         String            @default("PLATFORM")
  grantedById      String?
  grantedBy        User?             @relation("CapabilityGrantIssuer", fields: [grantedById], references: [id], onDelete: SetNull)
  reason           String?
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([userId, capability, scopeKey])
  @@index([userId, revokedAt])
}

/// Immutable, versioned price record: the only legitimate source of a charge
/// amount. Engineering must never select a figure from a published marketing
/// range such as the 99-299 Pro range (S-E2, S-M2).
model PriceCatalogEntry {
  id                String          @id @default(cuid())
  offer             CommercialOffer
  /// Market this price is approved for, ISO-3166-1 alpha-2.
  market            String
  /// ISO-4217, fixed per record. Never converted with live FX at checkout (S-M1).
  currency          String
  interval          BillingInterval
  /// Minor units (cents) so money is never a float.
  amountMinor       Int
  channel           BillingChannel
  /// Catalog version this record belongs to; a new price is a new version (S21).
  catalogVersion    String
  /// Provider identifiers, populated once the merchant entity is verified.
  providerProductId String?
  providerPriceId   String?
  /// Jurisdiction-specific; never a hard-coded rate (S-M3).
  taxBehavior       String          @default("UNSPECIFIED")
  /// Who approved this price into the catalog (S-P4).
  approvalReference String
  legalTermsVersion String?
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  /// Set once referenced by a finalized invoice. A locked record can never be
  /// mutated (S21).
  lockedAt          DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@unique([offer, market, currency, interval, channel, catalogVersion])
  @@index([offer, market, currency, interval, effectiveFrom])
}

/// Billing identity of a paying organization. Only ever created for a pharmacy
/// organization or institutional customer, never for a patient (S-A5).
model BillingProfile {
  id                 String  @id @default(cuid())
  legalName          String
  /// Verified merchant entity that appears on the invoice (S-P2).
  merchantEntity     String?
  billingEmail       String
  addressLine1       String?
  addressLine2       String?
  city               String?
  region             String?
  postalCode         String?
  country            String?
  taxId              String?
  taxExempt          Boolean @default(false)
  providerCustomerId String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  usageEvents   UsageEvent[]
  invoices      Invoice[]

  @@index([country])
}

/// A commercial agreement. For self-serve Pro, quantity is the number of
/// verified paid locations and every unit must resolve to a real location
/// (S-C1); for Enterprise the contracted quantity is authoritative (S-C5).
model Subscription {
  id                  String             @id @default(cuid())
  billingProfileId    String
  billingProfile      BillingProfile     @relation(fields: [billingProfileId], references: [id], onDelete: Cascade)
  offer               CommercialOffer
  state               SubscriptionState
  channel             BillingChannel
  /// Null for zero-cost offers and contracts priced outside the catalog.
  priceCatalogEntryId String?
  priceCatalogEntry   PriceCatalogEntry? @relation(fields: [priceCatalogEntryId], references: [id])
  quantity            Int                @default(1)

  /// When commercial obligation begins. Nothing before this is billable: the
  /// platform never back-bills historic participation (S-Q2).
  commercialEffectiveAt DateTime
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  /// Evaluation window. At expiry the location reverts to Network Core unless an
  /// affirmative purchase succeeded; it never auto-converts (S-E3).
  evaluationEndsAt      DateTime?
  /// Delinquency tracking (S-L1).
  paymentFailedAt       DateTime?
  canceledAt            DateTime?
  /// Enterprise contract terms; a self-serve Pro row leaves these null.
  contractReference     String?
  usageBillingEnabled   Boolean   @default(false)
  includedUsageUnits    Int?
  usageRateCardVersion  String?

  providerSubscriptionId String?

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  locations   SubscriptionLocation[]
  usageEvents UsageEvent[]
  invoices    Invoice[]

  @@index([state])
  @@index([offer, state])
}

/// Joins a paid subscription unit to the verified pharmacy location it covers,
/// so quantity can always be reconciled against real locations (S-C1).
model SubscriptionLocation {
  id                       String       @id @default(cuid())
  subscriptionId           String
  subscription             Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  pharmacyId               String
  pharmacy                 Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  activatedAt              DateTime     @default(now())
  /// Set when released. Capacity frees immediately; billed quantity reduces at
  /// renewal and no automatic refund is issued (S-C3).
  releasedAt               DateTime?
  prorationAmountMinor     Int?
  providerInvoiceReference String?

  @@unique([subscriptionId, pharmacyId])
  @@index([pharmacyId])
}

/// A metered usage record. Written for every attempt, billable or not, so
/// exclusions are auditable rather than silent (S-K2, S-J3).
model UsageEvent {
  id               String                @id @default(cuid())
  billingProfileId String?
  billingProfile   BillingProfile?       @relation(fields: [billingProfileId], references: [id], onDelete: SetNull)
  subscriptionId   String?
  subscription     Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// Contract-defined metric, e.g. API_REQUEST or AI_OUTPUT.
  metricCode       String
  endpointClass    String?
  requestId        String?
  responseStatus   Int?
  /// Billable units. Zero whenever exclusionReason is set.
  countableUnits   Int                   @default(0)
  exclusionReason  UsageExclusionReason?
  rateCardVersion  String?
  /// Guarantees a retried or duplicated event counts at most once (S-J3).
  idempotencyKey   String                @unique
  occurredAt       DateTime              @default(now())

  @@index([billingProfileId, occurredAt])
  @@index([metricCode, occurredAt])
}

// ---------------------------------------------------------------------------
// Commercial: payment provider, invoices, tax & service credits
// ZM-COM-BILL-001 — S-N, S-M, S-C4, S-F5
// ---------------------------------------------------------------------------

/// Which payment provider a record came from. Modelled explicitly so a second
/// provider, or a Finance-invoiced Enterprise contract, does not require
/// rewriting the schema (S-N1).
enum PaymentProvider {
  STRIPE
  FINANCE_MANUAL
}

/// Provider mode. Live and test records coexist, and only a commercial
/// classification may ever reference a live price (S-Q4).
enum ProviderMode {
  TEST
  LIVE
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSED
  IGNORED // not a subscribed event type
  FAILED
  DUPLICATE
}

/// Every webhook the platform receives, stored before it is acted on.
///
/// The executive doctrine states plainly that nobody may be charged because of a
/// duplicate webhook, and S-N5 makes a duplicate charge a P1 incident. The unique
/// provider event id is what makes that structural rather than aspirational: a
/// replayed delivery is recorded as DUPLICATE and never reprocessed.
model ProviderEvent {
  id               String              @id @default(cuid())
  provider         PaymentProvider     @default(STRIPE)
  mode             ProviderMode
  /// The provider's own event id, e.g. Stripe evt_… — the deduplication key.
  providerEventId  String              @unique
  eventType        String
  status           ProviderEventStatus @default(RECEIVED)
  /// Raw payload, retained for reconciliation and dispute evidence. Contains no
  /// patient or medicine data: billing objects never carry either (S-N2).
  payload          Json?
  failureReason    String?
  relatedInvoiceId String?
  processedAt      DateTime?
  receivedAt       DateTime            @default(now())

  @@index([eventType, receivedAt])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  UNCOLLECTIBLE
  VOID
  REFUNDED
  PARTIALLY_REFUNDED
}

/// A finalized commercial document.
///
/// Deliberately has no medicine, prescription, patient or search columns: S-N2
/// forbids putting any of them on an invoice, and the safest way to honour that is
/// to give them nowhere to live. What the customer bought is expressed as the
/// offer, the covered locations and the service period.
model Invoice {
  id               String         @id @default(cuid())
  billingProfileId String
  billingProfile   BillingProfile @relation(fields: [billingProfileId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  subscription     Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /// Human-facing sequential reference, distinct from the surrogate id.
  invoiceNumber       String        @unique
  status              InvoiceStatus @default(DRAFT)
  /// Verified supplier entity that appears on the document (S-N2, S-P2).
  supplierLegalEntity String
  customerLegalName   String
  /// Service period the charge covers.
  periodStart         DateTime
  periodEnd           DateTime
  /// How many verified paid locations this invoice covers (S-C1).
  locationCount       Int           @default(0)

  currency            String
  subtotalMinor       Int
  discountMinor       Int    @default(0)
  taxMinor            Int    @default(0)
  totalMinor          Int
  amountPaidMinor     Int    @default(0)
  amountRefundedMinor Int    @default(0)

  /// Resolved tax treatment. Never a hard-coded rate (S-M3).
  taxDeterminationId String?
  taxDetermination   TaxDetermination? @relation(fields: [taxDeterminationId], references: [id])

  provider                PaymentProvider @default(STRIPE)
  mode                    ProviderMode
  providerInvoiceId       String?
  providerPaymentIntentId String?
  /// Provider-hosted payment page for this invoice. Captured from the webhook so
  /// an unpaid invoice is actionable in the portal instead of a dead end. Stripe
  /// hosts it, so no card details ever reach this application.
  hostedInvoiceUrl        String?
  /// Catalog version the amounts were derived from, so a historic invoice can
  /// always be explained (S-21).
  catalogVersion          String?

  issuedAt  DateTime?
  paidAt    DateTime?
  voidedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  creditNotes CreditNote[]

  @@index([billingProfileId, createdAt])
  @@index([status])
  @@index([providerInvoiceId])
}

enum CreditNoteReason {
  SERVICE_CREDIT // SLA or platform-caused failure (S-F5, S-N4)
  BILLING_ERROR
  DUPLICATE_CHARGE // S-N5
  APPROVED_EXCEPTION // e.g. discretionary refund on location release (S-C3)
  CONTRACT_TERMINATION
}

/// A financial adjustment. Always references the invoice it corrects and the
/// person who approved it: S-N4 requires credits to flow through an approved
/// policy rather than ad hoc engineering action.
model CreditNote {
  id                   String           @id @default(cuid())
  invoiceId            String
  invoice              Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reason               CreditNoteReason
  amountMinor          Int
  currency             String
  /// Who approved the adjustment. Engineering supplies evidence; Finance decides.
  approvedByUserId     String?
  approvalReference    String?
  note                 String?
  /// Incident this credit answers, when it is an SLA or outage remedy.
  incidentReference    String?
  provider             PaymentProvider  @default(STRIPE)
  providerCreditNoteId String?
  createdAt            DateTime         @default(now())

  @@index([invoiceId])
  @@index([reason])
}

/// A resolved tax treatment for one customer, jurisdiction and moment.
///
/// Exists so that no percentage is ever hard-coded (S-M3): a charge references the
/// determination that produced its tax, and the inputs are kept so the figure can
/// be re-explained during an audit. ZoikoMeds never determines tax on the medicine
/// a patient later buys — that stays with the dispensing pharmacy (S-M4).
model TaxDetermination {
  id                 String   @id @default(cuid())
  billingProfileId   String
  /// Evidence of customer location used for the determination.
  customerCountry    String
  customerRegion     String?
  customerPostalCode String?
  /// Customer tax identity, where supplied.
  taxId              String?
  taxExempt          Boolean  @default(false)
  /// Product tax code for the SaaS/API/data service being sold.
  productTaxCode     String?
  /// Resolved outcome. Rate is stored in basis points to avoid float drift, and is
  /// an output of the determination — never an input constant.
  rateBasisPoints    Int
  taxAmountMinor     Int
  currency           String
  /// Reverse charge / zero-rated / not-registered outcomes must be explainable.
  treatment          String
  /// Which engine or manual approval produced this, plus its version.
  determinedBy       String
  determinationRef   String?
  jurisdictionNote   String?
  determinedAt       DateTime @default(now())

  invoices Invoice[]

  @@index([billingProfileId, determinedAt])
}

// ---------------------------------------------------------------------------
// Pharmacy POS / ERP integration (MP-31)
//
// The portal's Integration page was a fixture: it showed a connected Marg ERP
// and five invented sync runs to every pharmacy on the platform. These two
// models are what make it real — one configuration row per pharmacy, and one
// audit row per sync attempt.
//
// A sync is not a new write path: it fetches the pharmacy's own feed and hands
// the rows to the same PharmacyService.importCsv that the Uploads tab uses, so
// an integrated pharmacy and one uploading a CSV by hand produce identical
// AvailabilitySignal rows.
// ---------------------------------------------------------------------------

enum IntegrationSyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

/// How stock reaches ZoikoMeds for this pharmacy.
enum IntegrationDirection {
  /// ZoikoMeds fetches `feedUrl` on a schedule. Nothing to install at the
  /// pharmacy beyond exposing a file or endpoint.
  PULL
  /// The pharmacy's own system posts rows to /pharmacies/integration/push,
  /// authenticated with an issued API key. For systems behind a firewall that
  /// cannot be reached from outside.
  PUSH
}

model PharmacyIntegration {
  id         String   @id @default(cuid())
  pharmacyId String   @unique
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  /// Free text, shown as the connection's name: "Marg ERP", "Tally", a bespoke
  /// export. ZoikoMeds does not maintain a list of blessed vendors — the shape
  /// of the feed is the contract, not the product name.
  provider String

  direction IntegrationDirection @default(PULL)

  /// Paused rather than deleted. Disconnecting removes the row; this is the
  /// switch an operator flips while their POS is being upgraded, and it keeps
  /// the credentials and the history.
  enabled Boolean @default(true)

  // --- PULL configuration --------------------------------------------------

  /// http(s) only, and never an address inside the deployment's own network:
  /// the guard lives in feed.ts, because this column is operator-supplied and
  /// the server is the one that dials it.
  feedUrl String?

  /// Optional single auth header for the feed, e.g. Authorization / X-Api-Key.
  /// The value is encrypted at rest and is never returned by the API — the
  /// portal only ever learns whether one is set.
  authHeaderName   String?
  authHeaderSecret String?

  /// merge keeps medicines the feed does not mention; replace prunes them, so
  /// the feed becomes the whole truth about this pharmacy's stock.
  syncMode        String @default("merge")
  intervalMinutes Int    @default(60)

  // --- PUSH credentials ----------------------------------------------------

  /// SHA-256 of the issued key, never the key itself — same treatment as a
  /// password-reset token. The raw key is shown once, at issue.
  apiKeyHash     String?
  /// First characters of the key, so the portal can say which key is installed
  /// without being able to reconstruct it.
  apiKeyPrefix   String?
  apiKeyIssuedAt DateTime?

  // --- Scheduling state ----------------------------------------------------

  lastSyncAt     DateTime?
  lastSyncStatus IntegrationSyncStatus?
  nextSyncAt     DateTime?

  /// Held for the duration of a run. Claimed with a conditional update, so two
  /// API instances polling the same database cannot sync one pharmacy twice.
  /// A stale lock expires (see STALE_LOCK_MS) rather than wedging the feed.
  syncingSince DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs PharmacySyncRun[]

  @@index([enabled, nextSyncAt])
}

/// One sync attempt, successful or not. This is the Integration page's history
/// list, and the only record of why a feed stopped updating.
model PharmacySyncRun {
  id            String              @id @default(cuid())
  integrationId String
  integration   PharmacyIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  pharmacyId    String
  pharmacy      Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  /// manual | scheduled | push
  trigger String

  status     IntegrationSyncStatus
  startedAt  DateTime              @default(now())
  finishedAt DateTime?

  rows     Int @default(0)
  imported Int @default(0)
  updated  Int @default(0)
  skipped  Int @default(0)

  /// What the operator is told: "Delta sync", "4 rows skipped", or the reason
  /// the attempt failed. Never a stack trace — this is a customer-facing line.
  note String?

  @@index([pharmacyId, startedAt])
}
